# Salin file ini jadi .env.local, lalu isi nilainya dari
# dashboard Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role. WAJIB untuk fitur kelola akun staf (menu Staf),
# karena membuat akun berarti membuat user di Supabase Auth dan operasi
# itu tidak diizinkan dengan kunci anon.
#
# Ambil dari Supabase Dashboard > Project Settings > API > service_role.
#
# PENTING soal keamanan:
# - Variabel ini SENGAJA tanpa awalan NEXT_PUBLIC_ supaya tidak pernah
#   ikut terkirim ke peramban. Jangan menambahkan awalan itu.
# - Kunci ini menembus seluruh aturan RLS. Jangan dibagikan, jangan
#   di-commit ke git, dan jangan pernah dipakai di komponen klien.
# - Di server produksi (Vercel), isi lewat Environment Variables.
#
# Tanpa kunci ini aplikasi tetap berjalan seperti biasa. Hanya menu Staf
# yang menampilkan pesan bahwa fitur belum aktif.
SUPABASE_SERVICE_ROLE_KEY=

# Sandi akun staf yang dipakai skrip uji (scripts/uji-*.mts dan
# scripts/uji-rls-*.py). Dipisah ke sini supaya sandi TIDAK pernah ditulis di
# dalam berkas skrip, karena berkas skrip ikut ter-commit ke git.
#
# Isi dengan sandi akun uji yang berlaku. Kalau sandi staf diganti, ubah di
# sini satu kali dan semua skrip uji ikut memakai sandi baru.
#
# JANGAN di-commit. Berkas ini (.env*) sudah masuk .gitignore.
SANDI_UJI=
